#!/bin/sh
# Run Python against a specific local xarray tree.
#   tools/xrpr <tree>                 interactive console, `np` and `xr` preloaded
#   tools/xrpr <tree> <script.py>     run the script, then stay in the console (python -i)
#   tools/xrpr <tree> -c '<code>'
# <tree>: path to an xarray source checkout, relative or absolute.
# XARRAY_PYTHON selects an interpreter; defaults to this repo's .venv/bin/python.
# The tree's source shadows installed xarray. Reproducers live in tools/upstream_reproducers.
set -e
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n 2,8p "$0"
  exit 0
fi
if [ $# -eq 0 ] || [ ! -d "$1/xarray" ]; then
  printf 'Usage: tools/xrpr PATH_TO_XARRAY [script.py | -c CODE]\n' >&2
  exit 2
fi
TREE=$1
shift
ROOT=$(cd "$(dirname "$0")/.." && pwd)
REPRO=$ROOT/tools/upstream_reproducers
export PYTHONPATH="$TREE:$REPRO${PYTHONPATH:+:$PYTHONPATH}"
PY=${XARRAY_PYTHON:-$ROOT/.venv/bin/python}
if [ $# -eq 0 ]; then
  exec "$PY" -i -c "import numpy as np, xarray as xr; print('xarray from', xr.__file__)"
elif [ "$1" = "-c" ]; then
  exec "$PY" "$@"
else
  exec "$PY" -i "$@"
fi
